{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft material scalar edit preparation request",
  "description": "Planning example, not a complete operation registry. Authenticated identity is supplied by the transport/session, not this payload. Semantic checks remain required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_id",
    "base_revision",
    "idempotency_key",
    "mode",
    "commands",
    "limits"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "base_revision": {
      "type": "string",
      "pattern": "^rev:b3:[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "mode": {
      "const": "prepare"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "operation_version",
          "material_id",
          "parameter",
          "value"
        ],
        "properties": {
          "operation": {
            "const": "material.set_scalar"
          },
          "operation_version": {
            "const": 1
          },
          "material_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "parameter": {
            "enum": [
              "roughness",
              "metallic"
            ]
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_wall_ms",
        "max_added_bytes"
      ],
      "properties": {
        "max_wall_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "max_added_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        }
      }
    }
  },
  "$comment": "IDs and revision digest encodings are proposed wire choices. Presence, authorization, material model, revision validity, resource admission and actual atomicity cannot be proved by JSON Schema."
}
